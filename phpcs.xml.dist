<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <!-- Show progress and sniff codes -->
    <arg value="ps"/>

    <arg name="cache" value=".php_cs.cache"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <!-- Make sniff report relative -->
    <arg name="basepath" value="."/>

    <file>examples</file>
    <file>src</file>
    <file>tests</file>

    <exclude-pattern>examples/index.php</exclude-pattern>

    <rule ref="PhpMyAdmin"/>

    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint.UselessAnnotation">
        <exclude-pattern>src/ShapeRecord.php</exclude-pattern>
        <exclude-pattern>tests/UtilTest.php</exclude-pattern>
        <exclude-pattern>tests/ShapeFileTest.php</exclude-pattern>
    </rule>

    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint.MissingTraversableTypeHintSpecification">
        <severity>4</severity>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint.MissingTraversableTypeHintSpecification">
        <severity>4</severity>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingTraversableTypeHintSpecification">
        <severity>4</severity>
    </rule>
</ruleset>
